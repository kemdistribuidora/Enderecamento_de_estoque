{
  "name": "enderecamento-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "import:winthor:produtos": "tsx src/scripts/import-winthor-produtos.ts",
    "import:winthor:saldo": "tsx src/scripts/import-winthor-saldo.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
