# Sem estas vars, backend usa arquivo local (backend/data.sqlite) -- bom pra dev.
# Preencha as duas pra apontar pro banco Turso remoto (compartilhado entre maquinas).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# PIN unico de acesso. Definido -> toda rota /api exige o header x-app-pin (a tela pede o
# PIN uma vez e guarda no navegador). Vazio -> API aberta (so pra dev local).
APP_PIN=
# Opcional: URL(s) do frontend separadas por virgula (ex: https://estoque.vercel.app).
# Vazio -> aceita qualquer origem.
CORS_ORIGIN=
